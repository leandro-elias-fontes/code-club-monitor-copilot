# ---------------------------------------------------------------
# Code Monitor Copilot — variaveis de ambiente (todas opcionais)
# Sem nenhuma chave, o sistema roda 100% local (compilador + sandbox + motor ML).
# ---------------------------------------------------------------

# IA gratuita em cascata (tenta na ordem: Groq -> OpenRouter -> GitHub Models -> Ollama -> local)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# GITHUB_TOKEN=ghp_...
# GITHUB_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Modelo GGUF embutido (exige llama-cpp-python e ~4 GB de RAM)
# LOCAL_LLM_MODEL_PATH=data/models/qwen2.5-coder-3b-instruct-q4_k_m.gguf
# LOCAL_LLM_THREADS=2

# Acesso restrito: exige PIN para usar a API/interface
# MONITOR_ACCESS_PIN=1234

# Ajustes de desempenho do sandbox
# GCC_SYNTAX_CHECK=1            # 0 = pula a checagem extra -fsyntax-only (recomendado em CPU fraca)
# SANDBOX_SANITIZERS=0          # 1 = compila com ASan/UBSan (mais preciso, bem mais lento)
# SANDBOX_COMPILE_TIMEOUT=25    # segundos

# Porta do servidor (padrao 7860 no Docker)
# PORT=7860
